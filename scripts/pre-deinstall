#!/bin/sh
set -e
[ -z "${IPKG_INSTROOT:-}" ] || exit 0
/etc/init.d/routerbox stop
/usr/bin/routerbox cleanup
/etc/init.d/routerbox disable
uci -q delete firewall.routerbox || true
uci commit firewall
# Versions before 0.4.0 left the package key trusted system-wide.
rm -f /etc/apk/keys/routerbox.pub
exit 0
